static func _条(d: Dictionary) -> Dictionary:
	var 时距 := str(d.get("配送时间距离", ""))
	var 时间 := ""
	var 距离 := ""
	if 时距.contains(" "):
		var parts := 时距.split(" ", false)
		if parts.size() >= 1:
			时间 = str(parts[0])
		if parts.size() >= 2:
			距离 = str(parts[1])
	else:
		时间 = 时距
	var 价 := str(d.get("价格显示", "¥0"))
	var 送达分 := 时间.replace("分钟", "")
	var 出: Dictionary = {
		"id": str(d.get("id", "")),
		"数字id": int(d.get("数字id", 0)),
		"名字": str(d.get("名字", "")),
		"图片": str(d.get("图片", "")),
		"详情图": str(d.get("详情图", "")),
		"价格显示": 价,
		"评分": str(d.get("评分", "")),
		"口碑": str(d.get("口碑", "")),
		"用户评价1": str(d.get("用户评价1", "")),
		"用户评价2": str(d.get("用户评价2", "")),
		"配送时间": ("配送时间：%s" % 时间) if not 时间.is_empty() else "",
		"距离": 距离,
		"已售": str(d.get("已售", "")),
		"前标签": str(d.get("前标签", "")),
		"小词条": str(d.get("小词条", "")),
		"质量保证": str(d.get("质量保证", "")),
		"配送费": str(d.get("配送费", "配送费：¥0")),
		"配送时间距离": 时距,
		"店铺名称": str(d.get("店铺名称", "")),
		"附近拼单": "附近【10】人拼单",
		"套餐内容": str(d.get("套餐内容", "")),
		"套餐规格": str(d.get("套餐规格", "默认、食材安全放心吃")),
		"底边栏": "价格 %s ｜ 立即配送 %s送达" % [价, 时间 if not 时间.is_empty() else 送达分],
		"是否异常": bool(d.get("是否异常", false)),
		"门外描写": str(d.get("门外描写", "")),
		"吃饭提示": str(d.get("吃饭提示", "")),
		"女主文本最后说": str(d.get("女主文本最后说", "")),
		"关联id": int(d.get("关联id", 0)),
	}
	if not str(d.get("配送费", "")).begins_with("配送费") and str(d.get("配送费", "")).begins_with("¥"):
		出["配送费"] = "配送费：%s" % str(d.get("配送费"))
	return 出


static func _找正常(数字id: int) -> Dictionary:
	for 饭 in 正常饭:
		if int(饭.get("数字id", -1)) == 数字id:
			return 饭
	return {}


static func _异常(异常数字id: int, 关联正常id: int, 覆盖: Dictionary) -> Dictionary:
	var 基 := _找正常(关联正常id).duplicate(true)
	if 基.is_empty():
		基 = {}
	基["id"] = "a_%d" % 异常数字id
	基["数字id"] = 异常数字id
	基["是否异常"] = true
	基["关联id"] = 关联正常id
	for k in 覆盖.keys():
		基[k] = 覆盖[k]
	# 价格/配送变化时重算底边栏与拆分字段
	return _条(基)


const 图片目录 := "res://data/外卖图片/"
const 背景色池 := ["EFF0DD", "FCE802", "DBB4A4", "FEBC2F"]


## 同一份外卖复用同一背景色；没有则随机写入 饭["背景色"]
static func 取背景色(饭: Dictionary) -> Color:
	if not 饭.has("背景色") or str(饭["背景色"]).is_empty():
		饭["背景色"] = 背景色池[randi() % 背景色池.size()]
	return Color.html(str(饭["背景色"]))


static func 读图片(饭: Dictionary) -> Texture2D:
	var 文件名 := str(饭.get("图片", "")).strip_edges()
	if 文件名.is_empty():
		return null
	var 路径 := 图片目录 + 文件名
	if not ResourceLoader.exists(路径):
		return null
	return load(路径) as Texture2D


static func 读价格(饭: Dictionary) -> float:
	if 饭.has("价格"):
		return float(饭["价格"])
	var 显示 := str(饭.get("价格显示", "¥0")).replace("¥", "").replace("￥", "").strip_edges()
	# 兼容「5折后4.45元」「免单0.0元」
	var 数字 := ""
	for c in 显示:
		if (c >= "0" and c <= "9") or c == ".":
			数字 += c
	return 数字.to_float() if not 数字.is_empty() else 0.0


static func 复制一份(条目: Dictionary) -> Dictionary:
	return 条目.duplicate(true)


static func 抽取(池: Array, 数量: int) -> Array:
	var 可用: Array = 池.duplicate()
	可用.shuffle()
	var 结果: Array = []
	if 可用.is_empty() or 数量 <= 0:
		return 结果
	for i in 数量:
		结果.append(复制一份(可用[i % 可用.size()]))
	return 结果


static func 按数字id查找(数字id: int, 含异常: bool = true) -> Dictionary:
	for 饭 in 正常饭:
		if int(饭.get("数字id", -1)) == 数字id:
			return 复制一份(饭)
	if 含异常:
		for 饭 in 异常饭:
			if int(饭.get("数字id", -1)) == 数字id:
				return 复制一份(饭)
	return {}
